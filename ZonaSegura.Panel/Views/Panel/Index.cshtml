@model PanelModel
@{ViewData["Title"]="Mapa y reportes";var f=Model.Filtros;var states=new[]{"PENDIENTE_VALIDACION","VALIDADO","RECHAZADO","EN_ATENCION","ATENDIDO"};var metrics=Model.Datos.Metricas;string Number(double? value)=>value?.ToString(System.Globalization.CultureInfo.InvariantCulture)??"";}
<div class="page-heading"><div><div class="eyebrow">Panel de Alcaldía · Panorama territorial</div><h1>Mapa y reportes</h1><p class="muted">Consulta los incidentes de la ciudad y coordina la atención de los reportes validados.</p></div><a asp-action="Ordenes" class="btn btn-primary">Ver órdenes de intervención</a></div>
<form id="panel-filtros" method="get" class="surface filter-bar"><input name="Sur" type="hidden" value="@Number(f.Sur)"/><input name="Oeste" type="hidden" value="@Number(f.Oeste)"/><input name="Norte" type="hidden" value="@Number(f.Norte)"/><input name="Este" type="hidden" value="@Number(f.Este)"/><div><label for="desde" class="form-label">Desde (UTC)</label><input type="date" id="desde" name="Desde" value="@f.Desde.ToString("yyyy-MM-dd")" class="form-control" required/></div><div><label for="hasta" class="form-label">Hasta (UTC)</label><input type="date" id="hasta" name="Hasta" value="@f.Hasta.ToString("yyyy-MM-dd")" class="form-control" required/></div>
<div><label for="categoria" class="form-label">Categoría</label><select id="categoria" name="TipoIncidenteId" class="form-select"><option value="">Todas las categorías</option>@foreach(var t in Model.Tipos){<option value="@t.Id" selected="@(f.TipoIncidenteId==t.Id)">@t.Nombre</option>}</select></div>
<div><label for="estado" class="form-label">Estado</label><select id="estado" name="Estado" class="form-select"><option value="">Todos los estados</option>@foreach(var s in states){<option value="@s" selected="@(s==f.Estado)">@s.Replace('_',' ')</option>}</select></div>
<div><label for="veracidad" class="form-label">Índice mínimo</label><select id="veracidad" name="VeracidadMinima" class="form-select"><option value="">Cualquier índice</option>@foreach(var v in new[]{0d,.25,.5,.75,1}){<option value="@v.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(f.VeracidadMinima==v)">@v.ToString("P0")</option>}</select></div><button class="btn btn-primary align-self-end">Aplicar filtros</button><a asp-action="Index" class="align-self-end mb-2">Limpiar</a></form>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if(Model.Error!=null){<div class="alert alert-danger" role="alert">@Model.Error</div>}
@if(Model.Error==null&&ViewData.ModelState.IsValid){
<div id="panel-error" class="alert alert-danger" role="alert" hidden><span id="panel-error-message"></span> <button type="button" id="panel-reintentar" class="btn btn-sm btn-outline-danger ms-2">Reintentar</button><a id="panel-ingresar" asp-controller="Cuenta" asp-action="Ingresar" class="ms-2" hidden>Ingresar nuevamente</a></div>
<div class="metrics metrics-complete" id="panel-indicadores" aria-label="Indicadores del área visible"><div class="surface"><span>Reportes</span><strong data-metric="total">@metrics.Total</strong></div><div class="surface"><span>Pendientes</span><strong data-metric="pendientes">@metrics.Pendientes</strong></div><div class="surface"><span>Validados</span><strong data-metric="validados">@metrics.Validados</strong></div><div class="surface"><span>En atención</span><strong data-metric="enAtencion">@metrics.EnAtencion</strong></div><div class="surface"><span>Atendidos</span><strong data-metric="atendidos">@metrics.Atendidos</strong></div><div class="surface"><span>Rechazados</span><strong data-metric="rechazados">@metrics.Rechazados</strong></div><div class="surface"><span>Zonas altas</span><strong data-metric="zonasAltas">@metrics.ZonasAltas</strong></div></div>
<section class="surface map-section"><div class="section-heading"><div><h2>Concentración de incidentes confirmados</h2><p class="muted mb-0">Al mover o ampliar el mapa se actualizan los indicadores, las zonas y los reportes del área visible.</p></div><div class="map-options"><label><input type="checkbox" id="show-zones" checked/> Mostrar capa de riesgo</label><label><input type="checkbox" id="show-coverage" checked/> Mostrar límite de cobertura</label></div></div><div id="risk-map" role="region" aria-label="Mapa de incidentes y concentración de riesgo" data-datos-url="@Url.Action("Datos")" data-cobertura-url="@Url.Action("Cobertura")" data-asignar-url="@Url.Action("Asignar")"></div><p id="map-message" class="muted mt-2" role="status"></p><p id="coverage-message" class="muted" role="status"></p>
<div class="legend"><span><i class="swatch low"></i>Bajo: 1–2</span><span><i class="swatch medium"></i>Medio: 3–4</span><span><i class="swatch high"></i>Alto: 5 o más</span><span>Sin color: sin incidentes confirmados</span></div><p class="muted mb-0 mt-2">Celdas aproximadas de 500 m. El índice de votos no equivale a una confirmación institucional. La ausencia de reportes no garantiza seguridad.</p></section>
<section class="surface mt-4"><div class="section-heading"><h2>Zonas de mayor concentración</h2><span class="muted">Hasta 12 celdas, ordenadas por cantidad</span></div><ol id="critical-zones" class="zone-list">@foreach(var z in Model.Datos.Zonas.OrderByDescending(z=>z.Cantidad).ThenBy(z=>z.Id).Take(12)){<li><span class="state">@z.Nivel</span> @z.Cantidad incidentes confirmados · @z.Id</li>}@if(Model.Datos.Zonas.Count==0){<li class="muted">No hay zonas con incidentes confirmados en la consulta.</li>}</ol></section>
<section class="surface mt-4"><div class="section-heading"><h2>Reportes del área visible</h2><span id="report-period" class="muted">@f.Desde.ToString("dd/MM/yyyy") al @f.Hasta.ToString("dd/MM/yyyy")</span></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Reporte</th><th>Incidente</th><th>Fecha UTC</th><th>Estado</th><th>Índice</th><th>Gestión</th></tr></thead><tbody id="panel-reportes">
@foreach(var r in Model.Datos.Reportes){<tr><td>#@r.Id</td><td><strong>@r.TipoIncidenteNombre</strong><p class="report-description">@r.Descripcion</p></td><td>@r.FechaRegistroUtc.ToString("dd/MM/yyyy HH:mm")</td><td><span class="state">@r.Estado.Replace('_',' ')</span></td><td>@r.IndiceVeracidad.ToString("P0")</td><td>@if(r.Estado=="VALIDADO"){<a asp-action="Asignar" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Crear orden</a>}else if(r.Estado=="PENDIENTE_VALIDACION"){<span class="muted">En espera de validación</span>}</td></tr>}
@if(Model.Datos.Reportes.Count==0){<tr><td colspan="6" class="empty-state">No hay reportes para estos filtros.</td></tr>}
</tbody></table></div></section>
<script id="map-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Datos,new System.Text.Json.JsonSerializerOptions{PropertyNamingPolicy=System.Text.Json.JsonNamingPolicy.CamelCase}))</script>
}
@section Styles{<link rel="stylesheet" href="~/lib/leaflet/leaflet.css"/>}
@section Scripts{<script src="~/lib/leaflet/leaflet.js"></script><script src="~/js/mapa.js" asp-append-version="true"></script>}
