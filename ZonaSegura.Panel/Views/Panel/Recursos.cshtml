@model List<Recurso>
@{ViewData["Title"]="Recursos preventivos";}
<div class="page-heading"><div><div class="eyebrow">Disponibilidad operativa</div><h1>Recursos preventivos</h1></div><a asp-action="EditarRecurso" class="btn btn-primary">Registrar recurso</a></div>
<section class="surface table-responsive"><table class="table align-middle"><thead><tr><th>Recurso</th><th>Tipo</th><th>Unidad</th><th>Condición</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><strong>@r.Nombre</strong><small class="d-block muted">#@r.Id</small></td><td>@r.Tipo</td><td>#@r.UnidadId</td><td>@(r.Activo?"Activo":"Inactivo") · @(r.Disponible?"Disponible":"No disponible")</td><td><a asp-action="EditarRecurso" asp-route-id="@r.Id" class="btn btn-outline-primary btn-sm">Editar</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty-state">Registra una unidad y sus recursos para comenzar.</td></tr>}</tbody></table></section>
