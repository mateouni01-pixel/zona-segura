@using ZonaSegura.Panel.Services
@inject InterfacesUsuario Interfaces
@{
    var disponibles=Interfaces.Disponibles(User);
    var action=ViewContext.RouteData.Values["action"]?.ToString();
    var actual=Interfaces.Actual(Context,ViewContext.RouteData.Values["controller"]?.ToString())?.Interfaz;
    var autenticado=User.Identity?.IsAuthenticated==true;
    var titulo=actual?.Nombre??(autenticado?"Elegir interfaz":"Acceso a Zona Segura");
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>@ViewData["Title"] · Zona Segura</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles",false)
</head>
<body class="@(actual?.CssClase??"portal-acceso")">
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" asp-controller="@(actual?.Controlador??"Cuenta")" asp-action="@(actual?.Accion??(autenticado?"Interfaces":"Ingresar"))"><span class="brand-icon">ZS</span><span>Zona Segura<small>@titulo</small></span></a>
        @if(autenticado){
            @if(actual!=null){
                <div class="workspace-context"><span class="sidebar-label">Interfaz activa</span><strong>@actual.Nombre</strong></div>
                <nav aria-label="Menú de @actual.Nombre">
                    @foreach(var enlace in actual.Menu){
                        <a asp-controller="@actual.Controlador" asp-action="@enlace.Accion" aria-current="@(action==enlace.Accion||enlace.AccionesRelacionadas.Contains(action)?"page":null)">@enlace.Texto</a>
                    }
                </nav>
            }
            <div class="panel-switch"><span class="sidebar-label">@(disponibles.Count==1?"Una interfaz disponible":$"{disponibles.Count} interfaces disponibles")</span>
                <a asp-controller="Cuenta" asp-action="Interfaces">@(disponibles.Count>1?"Cambiar interfaz":"Mi interfaz")</a>
            </div>
            <div class="account"><div><span>@User.Identity?.Name</span><small>@titulo</small></div><form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="btn btn-outline-light btn-sm" type="submit">Cerrar sesión</button></form></div>
        }
        <p class="sidebar-note">@(actual?.Descripcion??"Elige cómo participar en Zona Segura con los permisos de tu cuenta.")</p>
    </aside>
    <div class="workspace">
        <header class="topbar"><span>@(actual?.Encabezado??"Zona Segura · Santa Cruz de la Sierra")</span><span class="portal-label">@titulo</span></header>
        <main id="contenido" tabindex="-1">
            @if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
            @if(TempData["Exito"] is string success){<div class="alert alert-success" role="status">@success</div>}
            @RenderBody()
        </main>
        <footer>Zona Segura · Las decisiones institucionales quedan registradas.</footer>
    </div>
</div>
<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts",false)
</body>
</html>
