@model LoginModel
@{ViewData["Title"]="Acceso a Zona Segura";}
<section class="login-wrap">
    <div class="eyebrow">Una cuenta · Tus interfaces</div><h1>Tu espacio de trabajo<br/>en Zona Segura.</h1>
    <p class="lead muted">Ingresa y elige cómo participar. Verás únicamente las interfaces que permiten los roles de tu cuenta.</p>
    <form asp-action="Ingresar" method="post" class="surface login-form"><h2>Iniciar sesión</h2><div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <label asp-for="Correo" class="form-label">Correo electrónico</label><input asp-for="Correo" class="form-control" autocomplete="username" maxlength="254"/><span asp-validation-for="Correo" class="text-danger"></span>
        <label asp-for="Password" class="form-label mt-3">Contraseña</label><input asp-for="Password" class="form-control" autocomplete="current-password"/><span asp-validation-for="Password" class="text-danger"></span>
        <button class="btn btn-primary w-100 mt-4">Ingresar</button><p class="muted mt-3 mb-0">Si tienes varios roles, podrás cambiar de interfaz desde el menú sin cerrar sesión.</p>
    </form>
</section>
