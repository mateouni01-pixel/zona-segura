<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Zs.Heading" android:text="@string/zs_validate_title"/>
        <TextView style="@style/Zs.Body" android:layout_marginTop="8dp" android:text="@string/zs_validate_subtitle"/>
        <com.google.android.material.chip.ChipGroup android:id="@+id/reportFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/reportFilterNearby" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zs_near_filter" android:checked="true"/>
            <com.google.android.material.chip.Chip android:id="@+id/reportFilterMine" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zs_mine_filter"/>
        </com.google.android.material.chip.ChipGroup>
        <LinearLayout android:id="@+id/citizenReportList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <LinearLayout android:id="@+id/citizenReportsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/zs_badge" android:visibility="gone">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/zs_ic_add" android:importantForAccessibility="no"/>
            <TextView style="@style/Zs.Section" android:layout_marginTop="12dp" android:text="@string/zs_empty_title"/>
            <TextView style="@style/Zs.Body" android:layout_marginTop="8dp" android:text="@string/zs_empty_body"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/citizenEmptyCreate" style="@style/Zs.Button" android:layout_marginTop="16dp" android:text="@string/zs_new_report"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
