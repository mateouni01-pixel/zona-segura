<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Zs.Card" android:layout_marginTop="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/reportCardMeta" style="@style/Zs.Eyebrow"/>
        <TextView android:id="@+id/reportCardType" style="@style/Zs.Section" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/reportCardDescription" style="@style/Zs.Body" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/reportCardState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/zs_status" android:textSize="12sp" android:textColor="@color/zs_amber"/>
        <TextView android:id="@+id/reportCardDistance" style="@style/Zs.Body" android:textSize="12sp" android:layout_marginTop="10dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/reportCardOpen" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/zs_open_report" app:icon="@drawable/zs_ic_check"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
