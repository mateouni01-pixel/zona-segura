<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/riskMapRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/civicColorBackground" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/riskMapBack"
                style="@style/Widget.ZonaSegura.Button.Text" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/map_back" />
            <TextView style="@style/CivicHeading" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="24sp"
                android:text="@string/map_title" android:accessibilityHeading="true" />
        </LinearLayout>
        <TextView android:id="@+id/riskMapStatus" style="@style/CivicBody" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textSize="14sp" android:layout_marginVertical="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_type"
                    android:labelFor="@id/riskMapType" android:textColor="?attr/civicColorText" />
                <Spinner android:id="@+id/riskMapType" android:layout_width="match_parent" android:layout_height="52dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_period"
                    android:labelFor="@id/riskMapPeriod" android:textColor="?attr/civicColorText" />
                <Spinner android:id="@+id/riskMapPeriod" android:layout_width="match_parent" android:layout_height="52dp" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/riskMapHeat"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/map_heat" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="420dp"
            app:cardCornerRadius="8dp" app:cardElevation="0dp"
            app:strokeColor="?attr/civicColorBorder" app:strokeWidth="1dp">
            <WebView android:id="@+id/riskMapWeb" android:layout_width="match_parent" android:layout_height="match_parent"
            android:contentDescription="@string/map_content_description" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="8dp" android:orientation="vertical"><ImageButton android:id="@+id/riskMapCity" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="4dp" android:padding="12dp" android:background="@drawable/civic_card" android:src="@drawable/map_city" android:contentDescription="@string/map_city" />
<ImageButton android:id="@+id/riskMapLocation" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="4dp" android:padding="12dp" android:background="@drawable/civic_card" android:src="@drawable/map_locate" android:contentDescription="@string/map_my_location" />
<ImageButton android:id="@+id/riskMapRefresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="4dp" android:padding="12dp" android:background="@drawable/civic_card" android:src="@drawable/map_refresh" android:contentDescription="@string/map_refresh" />
</LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/riskMapLocationStatus" style="@style/CivicBody" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textSize="13sp" />
        <TextView android:id="@+id/riskMapTilesNotice" style="@style/CivicBody" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" android:text="@string/map_tiles_offline"
            android:accessibilityLiveRegion="polite" android:layout_marginTop="8dp" />
        <TextView style="@style/CivicHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="18sp" android:text="Densidad de incidentes" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/civic_card"
            android:paddingVertical="12dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:textStyle="bold" android:textColor="#127052" android:text="@string/map_low" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:textStyle="bold" android:textColor="#865408" android:text="@string/map_medium" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:textStyle="bold" android:textColor="#A5233B" android:text="@string/map_high" />
        </LinearLayout>
        <TextView style="@style/CivicBody" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/map_privacy" android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
