<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/municipalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="vertical"
        android:padding="24dp">

        <include layout="@layout/civic_brand" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/municipal_title"
            style="@style/CivicHeading"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/municipal_description"
            style="@style/CivicBody" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/civic_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/municipalWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/civic_profile"
                android:textColor="@color/login_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/municipalCargo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/CivicBody" />

            <TextView
                android:id="@+id/municipalAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/CivicBody" />
        </LinearLayout>

        <TextView
            android:id="@+id/municipalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/home_checking"
            android:textColor="@color/login_secondary_text"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/municipalRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_retry"
            android:visibility="gone"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/municipalLogout"
            style="@style/Widget.ZonaSegura.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_logout"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
