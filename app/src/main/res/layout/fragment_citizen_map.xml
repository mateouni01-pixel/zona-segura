<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Zs.Eyebrow" android:text="@string/zs_map_eyebrow"/>
        <TextView style="@style/Zs.Heading" android:layout_marginTop="8dp" android:text="@string/zs_map_title"/>
        <TextView style="@style/Zs.Body" android:layout_marginTop="8dp" android:text="@string/zs_map_subtitle"/>
        <com.google.android.material.card.MaterialCardView style="@style/Zs.Card" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Zs.Body" android:padding="14dp" android:text="@string/zs_location" android:textStyle="bold" android:textColor="@color/zs_ink"/>
                <com.example.zonasegura.citizen.NeighborhoodMapView android:layout_width="match_parent" android:layout_height="230dp" android:contentDescription="@string/zs_map_accessible"/>
                <TextView style="@style/Zs.Body" android:padding="12dp" android:textSize="12sp" android:text="@string/zs_map_caption"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/Zs.Body" android:layout_marginTop="10dp" android:textSize="12sp" android:text="@string/zs_map_legend"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/mapFilters" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true">
                <com.google.android.material.chip.Chip android:id="@+id/mapFilterAll" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zs_all" android:checked="true"/>
                <com.google.android.material.chip.Chip android:id="@+id/mapFilterLighting" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zs_lighting"/>
                <com.google.android.material.chip.Chip android:id="@+id/mapFilterInfrastructure" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zs_infrastructure"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <TextView style="@style/Zs.Section" android:layout_marginTop="16dp" android:text="@string/zs_nearby"/>
        <LinearLayout android:id="@+id/mapReportList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/mapCreateReport" style="@style/Zs.Button" android:layout_marginTop="12dp" android:text="@string/zs_new_report" app:icon="@drawable/zs_ic_add"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
