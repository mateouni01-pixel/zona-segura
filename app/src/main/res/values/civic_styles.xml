<resources>
    <style name="CivicHeading">
        <item name="android:textColor">@color/login_text</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="CivicBody">
        <item name="android:textColor">@color/login_secondary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Widget.ZonaSegura.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <style name="Widget.ZonaSegura.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="strokeColor">@color/civic_border</item>
    </style>
    <style name="Widget.ZonaSegura.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
