<resources>
    <style name="Zs" />
    <color name="zs_ink">#142D29</color>
    <color name="zs_muted">#5A726A</color>
    <color name="zs_green">#176B54</color>
    <color name="zs_soft">#E6F2EC</color>
    <color name="zs_canvas">#F5F7F3</color>
    <color name="zs_line">#DEE6DF</color>
    <color name="zs_amber">#8A5708</color>
    <color name="zs_amber_soft">#FFF0D5</color>
    <style name="Theme.ZonaSegura.Citizen" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/zs_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/zs_green</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/zs_canvas</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/zs_canvas</item>
        <item name="android:colorAccent">@color/zs_green</item>
    </style>
    <style name="Zs.Heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/zs_ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Zs.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/zs_ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Zs.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/zs_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Zs.Eyebrow" parent="Zs.Body">
        <item name="android:textColor">@color/zs_green</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="Zs.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Zs.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/zs_line</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
